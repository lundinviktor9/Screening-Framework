# Brunswick Screening Framework — environment variables
# Copy to .env for local dev (webpack reads MAPBOX_TOKEN/API_BASE; the extractor
# reads the rest). On Railway, set these as service variables instead of a file.

# --- Required everywhere ---------------------------------------------------------
# Claude API key for deal extraction + showcase enrichment.
ANTHROPIC_API_KEY=sk-ant-...

# Mapbox token for the map. BAKED INTO THE FRONTEND BUNDLE AT BUILD TIME, so on
# Railway it must be present for the Docker BUILD (it is passed as a build ARG).
# Restrict the token to your Railway domain in the Mapbox dashboard.
MAPBOX_TOKEN=pk....

# --- Frontend API base (optional) ------------------------------------------------
# Where the frontend calls the API. Leave UNSET:
#   dev build  -> http://localhost:8787 (separate extractor port)
#   prod build -> '' (same-origin; FastAPI serves the bundle)
# API_BASE=

# --- Deployment / state ----------------------------------------------------------
# Single root for all mutable state. On Railway, mount a PERSISTENT VOLUME here,
# otherwise every deal/run is lost on redeploy. Unset locally = in-repo paths.
DATA_DIR=/data

# --- Auth (Task 3.2) — set ALL of these to turn login ON; unset = login OFF ------
# Comma-separated user:bcrypt-hash pairs. Generate a hash:
#   python -m extractor.auth hash 'their-password'
APP_USERS=viktor:$2b$12$REPLACE_WITH_REAL_HASH
# Long random string that signs the session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Failed-login rate limit (per client IP) and cookie security. Defaults shown.
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_SECONDS=300
# COOKIE_SECURE=1   # set 0 only to test login over plain HTTP locally

# --- Underwrite (optional overrides) ---------------------------------------------
# Model used to map a rent roll's columns (Mode A). Defaults to claude-sonnet-4-6.
# UNDERWRITE_MAP_MODEL=claude-sonnet-4-6
# Extra browser origins allowed by CORS (local dev only; same-origin in prod).
# CORS_ORIGINS=

{
  "name": "screening-framework-v1",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:scores": "node scripts/build-scored-markets.js",
    "lint": "eslint .",
    "extractor": "python -m uvicorn extractor.server:app --host 0.0.0.0 --port 8787",
    "ingest-inbox": "curl -X POST http://localhost:8787/ingest-folder?folder_path=deals_inbox",
    "app": "taskkill //F //IM python.exe 2>nul & taskkill //F //IM node.exe 2>nul || true && concurrently --kill-others-on-fail --names \"API,UI\" -c \"blue,green\" \"python -m uvicorn extractor.server:app --port 8787\" \"npm run dev\""
  },
